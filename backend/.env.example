# ============================================================================
# JobPilot Backend — Environment Variables
# ============================================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env with real secrets.

# ---- Database (PostgreSQL) ----
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_auto_pilot
# Sync URL used by Alembic migrations (psycopg2)
DATABASE_URL_SYNC=postgresql+postgres:postgres@localhost:5432/job_auto_pilot

# ---- JWT Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ---- AES-256-GCM encryption key (for LinkedIn credentials at rest) ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_KEY=change-me-to-a-fernet-key

# ---- Backend server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5000

# ---- File uploads ----
UPLOADS_DIR=backend/uploads
MAX_RESUME_SIZE_MB=10

# ---- Agent integration ----
# Path to the repo root (where runAiBot.py lives). Defaults to parent of backend/.
REPO_ROOT=.
# Chrome remote debugging port range (for CDP screenshot streaming)
CDP_PORT_START=9223
